# Server
PORT=8300
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=perfostand_db
DB_USERNAME=perfostand_user
DB_PASSWORD=

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Первый админ (сидится при старте, если не существует)
ADMIN_EMAIL=admin@perfostand.com
ADMIN_PASSWORD=

# Кристал (источник синхронизации продукции)
CRYSTAL_API_URL=http://127.0.0.1:8200
# Должен совпадать с CRM_API_KEY на кристале
CRYSTAL_API_KEY=

# Synology WebDAV (хранилище фото отзывов и пр.)
WEBDAV_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
# Корневая папка на Synology (внутри доступного юзеру шара)
WEBDAV_ROOT=/crystal-data/perfostand
